# Pegasus Trading Bot — Environment Variables
# Copy to .env.secrets and fill in your values

# Hyperliquid API
export HL_API_WALLET_ADDRESS="your_wallet_address"
export HL_API_PRIVATE_KEY="your_private_key"

# Telegram Alerts
export PEGASUS_TG_TOKEN="your_telegram_bot_token"
export PEGASUS_TG_CHAT_ID="your_telegram_chat_id"
